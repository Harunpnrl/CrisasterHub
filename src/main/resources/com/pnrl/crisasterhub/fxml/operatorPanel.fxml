<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>

<StackPane stylesheets="@../css/operator.css" styleClass="root-bg"
           prefWidth="1920" prefHeight="1080"
           xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.pnrl.crisasterhub.OperatorController">

    <BorderPane>
        <top>
            <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="24">
                <padding>
                    <Insets top="18" bottom="18" left="40" right="40"/>
                </padding>
                <Label text="❖ CRISASTER HUB" styleClass="brand-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Log Out" styleClass="btn-logout" onAction="#handleLogout"/>
            </HBox>
        </top>

        <center>
            <ScrollPane fitToWidth="true" styleClass="edge-to-edge-scroll">
                <VBox spacing="48">
                    <padding>
                        <Insets top="50" bottom="90" left="60" right="60"/>
                    </padding>

                    <!-- HERO ROW -->
                    <HBox alignment="BOTTOM_LEFT" spacing="40">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Admin Control Panel" styleClass="hero-title"/>
                        </VBox>
                    </HBox>

                    <!-- ═══════════════════════════════════════════════ -->
                    <!-- RESOURCE INVENTORY SECTION -->
                    <!-- ═══════════════════════════════════════════════ -->
                    <VBox spacing="24">
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label text="🗄" style="-fx-text-fill: #b0c6ff; -fx-font-size: 28;"/>
                            <Label text="Resource Inventory" styleClass="section-title"/>
                        </HBox>

                        <FlowPane hgap="24" vgap="24" prefWrapLength="1800">

                            <!-- Food & Water -->
                            <VBox styleClass="inv-card" prefWidth="420">
                                <HBox alignment="TOP_CENTER">
                                    <Label text="💧" styleClass="inv-icon, inv-icon-primary"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="foodBadge" text="Stable" styleClass="inv-badge-success"/>
                                </HBox>
                                <Label text="Food &amp; Water" styleClass="inv-title"/>
                                <VBox spacing="7">
                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="CURRENT STOCK" styleClass="inv-stat-label"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="foodStockLabel" text="0 Units" styleClass="inv-stat-label"/>
                                    </HBox>
                                    <ProgressBar fx:id="foodProgressBar" progress="0.0" maxWidth="Infinity"
                                                 styleClass="prog-error"/>
                                    <Label text="Depletion in approx. 18 hours" styleClass="inv-footer"/>
                                </VBox>
                            </VBox>

                            <!-- Medical -->
                            <VBox styleClass="inv-card" prefWidth="420">
                                <HBox alignment="TOP_CENTER">
                                    <Label text="✚" styleClass="inv-icon, inv-icon-tertiary"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="medBadge" text="Stable" styleClass="inv-badge-success"/>
                                </HBox>
                                <Label text="Medical" styleClass="inv-title"/>
                                <VBox spacing="7">
                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="CURRENT STOCK" styleClass="inv-stat-label"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="medStockLabel" text="0 Units" styleClass="inv-stat-label"/>
                                    </HBox>
                                    <ProgressBar fx:id="medProgressBar" progress="0.0" maxWidth="Infinity"
                                                 styleClass="prog-tertiary"/>
                                    <Label text="Resupply scheduled for Wed" styleClass="inv-footer"/>
                                </VBox>
                            </VBox>

                            <!-- Shelter -->
                            <VBox styleClass="inv-card" prefWidth="420">
                                <HBox alignment="TOP_CENTER">
                                    <Label text="⛺" styleClass="inv-icon, inv-icon-primary"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="shelterBadge" text="Stable" styleClass="inv-badge-success"/>
                                </HBox>
                                <Label text="Shelter" styleClass="inv-title"/>
                                <VBox spacing="7">
                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="CURRENT STOCK" styleClass="inv-stat-label"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="shelterStockLabel" text="0 Kits" styleClass="inv-stat-label"/>
                                    </HBox>
                                    <ProgressBar fx:id="shelterProgressBar" progress="0.0" maxWidth="Infinity"
                                                 styleClass="prog-primary"/>
                                    <Label text="Pending delivery: 200 kits" styleClass="inv-footer"/>
                                </VBox>
                            </VBox>

                            <!-- Clothing -->
                            <VBox styleClass="inv-card" prefWidth="420">
                                <HBox alignment="TOP_CENTER">
                                    <Label text="👕" styleClass="inv-icon, inv-icon-secondary"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="clothingBadge" text="Stable" styleClass="inv-badge-success"/>
                                </HBox>
                                <Label text="Clothing" styleClass="inv-title"/>
                                <VBox spacing="7">
                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="CURRENT STOCK" styleClass="inv-stat-label"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="clothingStockLabel" text="0 Sets" styleClass="inv-stat-label"/>
                                    </HBox>
                                    <ProgressBar fx:id="clothingProgressBar" progress="0.0" maxWidth="Infinity"
                                                 styleClass="prog-secondary"/>
                                    <Label text="Winter stock replenished" styleClass="inv-footer"/>
                                </VBox>
                            </VBox>
                        </FlowPane>
                    </VBox>

                    <!-- ═══════════════════════════════════════════════ -->
                    <!-- AID REQUESTS MANAGEMENT TABLE -->
                    <!-- ═══════════════════════════════════════════════ -->
                    <VBox styleClass="panel-container" spacing="0">
                        <HBox styleClass="panel-header" alignment="CENTER_LEFT" spacing="18">
                            <Label text="📋" style="-fx-text-fill: #a5c9f9; -fx-font-size: 24;"/>
                            <Label text="Aid Requests Management" styleClass="panel-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <TextField fx:id="searchField" promptText="Search requests..." styleClass="search-input"/>
                        </HBox>

                        <TableView fx:id="aidRequestsTable" prefHeight="350">
                            <columns>
                                <TableColumn fx:id="colReqId" text="REQUEST ID" prefWidth="100"/>
                                <TableColumn fx:id="colUserId" text="USER ID" prefWidth="80"/>
                                <TableColumn fx:id="colLocationId" text="LOCATION ID" prefWidth="90"/>
                                <TableColumn fx:id="colCategory" text="CATEGORY" prefWidth="120"/>
                                <TableColumn fx:id="colUrgency" text="URGENCY" prefWidth="100"/>
                                <TableColumn fx:id="colDescription" text="DESCRIPTION" prefWidth="250"/>
                                <TableColumn fx:id="colStatus" text="STATUS" prefWidth="100"/>
                                <TableColumn fx:id="colCreatedAt" text="CREATED AT" prefWidth="140"/>
                                <TableColumn fx:id="colActions" text="ACTIONS" prefWidth="150"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                        </TableView>
                    </VBox>

                    <!-- ═══════════════════════════════════════════════ -->
                    <!-- RESOURCE INVENTORY MANAGEMENT TABLE -->
                    <!-- ═══════════════════════════════════════════════ -->
                    <VBox styleClass="panel-container" spacing="0">
                        <HBox styleClass="panel-header" alignment="CENTER_LEFT" spacing="18">
                            <Label text="🗃" style="-fx-text-fill: #b0c6ff; -fx-font-size: 24;"/>
                            <Label text="Resource Inventory Management" styleClass="panel-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <TextField fx:id="resourceSearchField" promptText="Search resources..."
                                       styleClass="search-input"/>
                        </HBox>

                        <!-- REPLACED HARDCODED ROWS WITH REAL TABLEVIEW -->
                        <TableView fx:id="resourceTable" prefHeight="350">
                            <columns>
                                <TableColumn fx:id="colResId" text="RESOURCE ID" prefWidth="110"/>
                                <TableColumn fx:id="colResUserId" text="USER ID" prefWidth="90"/>
                                <TableColumn fx:id="colResLocationId" text="LOCATION ID" prefWidth="100"/>
                                <TableColumn fx:id="colResCategory" text="CATEGORY" prefWidth="130"/>
                                <TableColumn fx:id="colResQty" text="QUANTITY" prefWidth="100"/>
                                <TableColumn fx:id="colResDesc" text="DESCRIPTION" prefWidth="280"/>
                                <TableColumn fx:id="colResCreatedAt" text="CREATED AT" prefWidth="150"/>
                                <TableColumn fx:id="colResActions" text="ACTIONS" prefWidth="150"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                        </TableView>

                    </VBox>

                    <!-- ═══════════════════════════════════════════════ -->
                    <!-- ASSIGNMENT MANAGEMENT TABLE -->
                    <!-- ═══════════════════════════════════════════════ -->
                    <VBox styleClass="panel-container" spacing="0">
                        <HBox styleClass="panel-header" alignment="CENTER_LEFT" spacing="18">
                            <Label text="🔗" style="-fx-text-fill: #c5c6d0; -fx-font-size: 24;"/>
                            <Label text="Assignment Management" styleClass="panel-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <TextField promptText="Search assignments..." styleClass="search-input"/>
                        </HBox>

                        <!-- REPLACED HARDCODED ROWS WITH REAL TABLEVIEW -->
                        <TableView fx:id="assignmentTable" prefHeight="350">
                            <columns>
                                <TableColumn fx:id="colAsnId" text="ASSIGNMENT ID" prefWidth="130"/>
                                <TableColumn fx:id="colAsnReqId" text="REQUEST ID" prefWidth="120"/>
                                <TableColumn fx:id="colAsnResId" text="RESOURCE ID" prefWidth="120"/>
                                <TableColumn fx:id="colAsnQty" text="ASSIGNED QTY" prefWidth="120"/>
                                <TableColumn fx:id="colAsnStatus" text="STATUS" prefWidth="120"/>
                                <TableColumn fx:id="colAsnAssignedAt" text="ASSIGNED AT" prefWidth="150"/>
                                <TableColumn fx:id="colAsnUpdatedAt" text="UPDATED AT" prefWidth="150"/>
                                <TableColumn fx:id="colAsnActions" text="ACTION" prefWidth="160"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                        </TableView>
                    </VBox>

                </VBox>
            </ScrollPane>
        </center>
    </BorderPane>
</StackPane>
