<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.web.WebView?>

<BorderPane prefHeight="900.0" prefWidth="1360.0" styleClass="root-canvas" stylesheets="@../css/volunteer.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pnrl.crisasterhub.VolunteerController">

    <!-- TOP APP BAR -->
    <top>
        <StackPane styleClass="top-navbar">
            <padding>
                <Insets bottom="16.0" left="36.0" right="36.0" top="16.0" />
            </padding>

            <!-- Sol: Marka Logosu -->
            <HBox alignment="CENTER_LEFT" spacing="12.0" StackPane.alignment="CENTER_LEFT">
                <SVGPath content="M19 13h-4.17l2.95-2.95-1.41-1.41L13.41 11.6V7h-2v4.59L8.46 8.64 7.05 10.05 10 13H5v2h5l-2.95 2.95 1.41 1.41 2.95-2.95V21h2v-4.59l2.95 2.95 1.41-1.41L14.83 15H19v-2z" scaleX="0.95" scaleY="0.95" styleClass="brand-icon-svg" />
                <HBox alignment="CENTER_LEFT">
                    <Label styleClass="brand-title-main" text="Crisaster" />
                    <Label styleClass="brand-title-accent" text="HUB" />
                </HBox>
            </HBox>

            <!-- Orta: Panel Başlığı -->
            <VBox alignment="CENTER" mouseTransparent="true" StackPane.alignment="CENTER">
                <Label styleClass="panel-header-badge" text="Volunteer Panel" />
            </VBox>

            <!-- Sağ: Log Out Butonu -->
            <HBox alignment="CENTER_RIGHT" StackPane.alignment="CENTER_RIGHT">
                <Button fx:id="logoutBtn" onAction="#handleLogout" styleClass="logout-btn" text="Log Out" />
            </HBox>
        </StackPane>
    </top>

    <!-- ANA İÇERİK ALANI -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="main-scroll">
            <VBox spacing="28.0">
                <padding>
                    <Insets bottom="40.0" left="44.0" right="44.0" top="32.0" />
                </padding>

                <!-- Üst Karşılama Başlığı -->
                <VBox spacing="6.0">
                    <Label styleClass="page-title" text="Volunteer Portal" />
                    <Label styleClass="page-subtitle" text="Manage your active deployments and register new resources for the relief network." wrapText="true" />
                </VBox>

                <!-- 2 Sütunlu Ana Yerleşim (Sol: 34%, Sağ: 66%) -->
                <HBox alignment="TOP_LEFT" spacing="28.0">

                    <!-- SOL SÜTUN: SUBMIT RESOURCE FORMU -->
                    <VBox maxWidth="420.0" minWidth="340.0" spacing="22.0" styleClass="glass-panel" HBox.hgrow="SOMETIMES">
                        <padding>
                            <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
                        </padding>

                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <SVGPath content="M20 2H4c-1 0-2 .9-2 2v3.01c0 .72.43 1.34 1 1.69V20c0 1.1 1.1 2 2 2h14c.9 0 2-.9 2-2V8.7c.57-.35 1-.97 1-1.69V4c0-1.1-1-2-2-2zm-5 12H9v-2h6v2zm5-7H4V4h16v3z" scaleX="0.85" scaleY="0.85" styleClass="section-icon-tertiary" />
                            <Label styleClass="card-title" text="Submit Resource" />
                        </HBox>

                        <VBox spacing="8.0">
                            <Label styleClass="field-label" text="CATEGORY" />
                            <ComboBox fx:id="resourceCategoryCombo" maxWidth="Infinity" promptText="Select Category" styleClass="dark-combo" />
                        </VBox>

                        <VBox spacing="8.0">
                            <Label styleClass="field-label" text="YOUR LOCATION" />
                            <Label fx:id="volunteerMapStatusLabel" styleClass="map-status-text" text="CLICK MAP TO SET LOCATION" />
                            <StackPane prefHeight="190.0" styleClass="map-container-frame">
                                <WebView fx:id="volunteerMapWebView" prefHeight="190.0" />
                            </StackPane>
                        </VBox>

                        <VBox spacing="8.0">
                            <Label styleClass="field-label" text="QUANTITY" />
                            <TextField fx:id="resourceQuantityField" promptText="0" styleClass="dark-input" />
                        </VBox>

                        <VBox spacing="8.0">
                            <Label styleClass="field-label" text="DESCRIPTION" />
                            <TextArea fx:id="resourceDescriptionArea" prefRowCount="3" promptText="Specify item details..." styleClass="dark-textarea" wrapText="true" />
                        </VBox>

                        <Button fx:id="registerResourceBtn" maxWidth="Infinity" onAction="#handleRegisterResource" styleClass="indigo-gradient-btn" text="Register Resource" />
                    </VBox>

                    <!-- SAĞ SÜTUN: ACTIVE TASKS, AVAILABLE TASKS, MY RESOURCES -->
                    <VBox spacing="30.0" HBox.hgrow="ALWAYS">

                        <!-- 1. MY ACTIVE TASKS -->
                        <VBox spacing="14.0">
                            <HBox alignment="CENTER_LEFT" spacing="12.0">
                                <SVGPath content="M17 12h-5v5h5v-5zM16 1v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2h-1V1h-2zm3 18H5V8h14v11z" scaleX="0.85" scaleY="0.85" styleClass="section-icon-primary" />
                                <Label styleClass="section-title" text="My Active Tasks" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="activeTaskCountBadge" styleClass="pill-badge-tertiary" text="0 IN PROGRESS" />
                            </HBox>

                            <!-- Dinamik Aktif Görev Kartları Konteyneri -->
                            <FlowPane fx:id="activeTasksContainer" hgap="16.0" vgap="16.0" />
                        </VBox>

                        <!-- 2. AVAILABLE TASKS -->
                        <VBox spacing="14.0">
                            <HBox alignment="CENTER_LEFT" spacing="12.0">
                                <SVGPath content="M19 13h-4.17l2.95-2.95-1.41-1.41L13.41 11.6V7h-2v4.59L8.46 8.64 7.05 10.05 10 13H5v2h5l-2.95 2.95 1.41 1.41 2.95-2.95V21h2v-4.59l2.95 2.95 1.41-1.41L14.83 15H19v-2z" scaleX="0.85" scaleY="0.85" styleClass="section-icon-error" />
                                <Label styleClass="section-title" text="Available Tasks" />
                                <Region HBox.hgrow="ALWAYS" />
                                <TextField fx:id="taskSearchField" prefWidth="240.0" promptText="Search tasks by description..." styleClass="search-input" />
                            </HBox>

                            <!-- Dinamik Müsait Görev Satırları Konteyneri -->
                            <VBox fx:id="availableTasksContainer" spacing="12.0" />
                        </VBox>

                        <!-- 3. MY RESOURCES -->
                        <VBox spacing="14.0">
                            <HBox alignment="CENTER_LEFT" spacing="12.0">
                                <SVGPath content="M20 2H4c-1 0-2 .9-2 2v3.01c0 .72.43 1.34 1 1.69V20c0 1.1 1.1 2 2 2h14c.9 0 2-.9 2-2V8.7c.57-.35 1-.97 1-1.69V4c0-1.1-1-2-2-2zm-5 12H9v-2h6v2zm5-7H4V4h16v3z" scaleX="0.85" scaleY="0.85" styleClass="section-icon-primary" />
                                <Label styleClass="section-title" text="My Resources" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="resourceCountBadge" styleClass="pill-badge-primary" text="0 LISTED" />
                            </HBox>

                            <StackPane styleClass="table-glass-wrapper">
                                <TableView fx:id="resourcesTable" prefHeight="250.0" styleClass="dark-table">
                                    <columns>
                                        <TableColumn fx:id="colResCategory" prefWidth="180.0" text="RESOURCE TYPE" />
                                        <TableColumn fx:id="colResAmount" prefWidth="130.0" text="AMOUNT" />
                                        <TableColumn fx:id="colResDescription" prefWidth="300.0" text="DESCRIPTION" />
                                        <TableColumn fx:id="colResActions" prefWidth="160.0" text="ACTIONS" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>

                                <!-- Boş Durum (Empty State) -->
                                <VBox fx:id="emptyResourcesState" alignment="CENTER" managed="false" spacing="8.0" visible="false">
                                    <padding>
                                        <Insets bottom="32.0" left="24.0" right="24.0" top="32.0" />
                                    </padding>
                                    <Label styleClass="empty-state-title" text="You haven't added any resources yet." />
                                    <Label styleClass="empty-state-sub" text="Register provisions and equipment using the Submit Resource form to support ongoing relief operations." wrapText="true" />
                                </VBox>
                            </StackPane>
                        </VBox>

                    </VBox>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
