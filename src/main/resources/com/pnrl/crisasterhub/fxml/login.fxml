<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<StackPane fx:id="rootPane" prefHeight="760.0" prefWidth="1024.0" styleClass="root-canvas" stylesheets="@../css/login.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pnrl.crisasterhub.LoginController">

    <!-- Arka Plan Dekoratif Glow Efektleri -->
    <StackPane mouseTransparent="true">
        <Circle radius="260.0" styleClass="bg-glow-primary" StackPane.alignment="TOP_LEFT">
            <StackPane.margin>
                <Insets left="-80.0" top="-80.0" />
            </StackPane.margin>
        </Circle>
        <Circle radius="240.0" styleClass="bg-glow-tertiary" StackPane.alignment="BOTTOM_RIGHT">
            <StackPane.margin>
                <Insets bottom="-80.0" right="-80.0" />
            </StackPane.margin>
        </Circle>
    </StackPane>

    <VBox alignment="CENTER" maxWidth="540.0" spacing="28.0">
        <padding>
            <Insets bottom="24.0" left="20.0" right="20.0" top="24.0" />
        </padding>

        <VBox alignment="CENTER" spacing="6.0">
            <HBox alignment="CENTER">
                <Label styleClass="brand-title-main" text="Crisaster" />
                <Label styleClass="brand-title-accent" text="HUB" />
            </HBox>
            <Label styleClass="brand-subtitle" text="Disaster Coordination &amp; Crisis Management System." />
        </VBox>

        <VBox styleClass="glass-panel">

            <HBox spacing="8.0" styleClass="tab-header-bar">
                <padding>
                    <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                </padding>
                <fx:define>
                    <ToggleGroup fx:id="authTabGroup" />
                </fx:define>
                <ToggleButton fx:id="tabSignin" maxWidth="Infinity" onAction="#handleSwitchToSignIn" selected="true" styleClass="auth-tab-btn" text="SIGN IN" toggleGroup="$authTabGroup" HBox.hgrow="ALWAYS">
                    <graphic>
                        <SVGPath content="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z" scaleX="0.75" scaleY="0.75" styleClass="tab-icon" />
                    </graphic>
                </ToggleButton>
                <ToggleButton fx:id="tabRegister" maxWidth="Infinity" onAction="#handleSwitchToRegister" styleClass="auth-tab-btn" text="REGISTER" toggleGroup="$authTabGroup" HBox.hgrow="ALWAYS">
                    <graphic>
                        <SVGPath content="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" scaleX="0.75" scaleY="0.75" styleClass="tab-icon" />
                    </graphic>
                </ToggleButton>
            </HBox>

            <!-- Form -->
            <StackPane>
                <padding>
                    <Insets bottom="36.0" left="36.0" right="36.0" top="32.0" />
                </padding>

                <!-- SIGN IN PANE -->
                <VBox fx:id="signinPane" spacing="22.0">

                    <!-- Access Level -->
                    <VBox spacing="10.0">
                        <Label styleClass="field-label" text="ACCESS LEVEL" />
                        <HBox spacing="8.0" styleClass="role-container">
                            <padding>
                                <Insets bottom="6.0" left="6.0" right="6.0" top="6.0" />
                            </padding>
                            <fx:define>
                                <ToggleGroup fx:id="roleGroup" />
                            </fx:define>
                            <ToggleButton fx:id="roleVictim" maxWidth="Infinity" selected="true" styleClass="role-chip" text="Victim" toggleGroup="$roleGroup" userData="VICTIM" HBox.hgrow="ALWAYS" />
                            <ToggleButton fx:id="roleVolunteer" maxWidth="Infinity" styleClass="role-chip" text="Volunteer" toggleGroup="$roleGroup" userData="VOLUNTEER" HBox.hgrow="ALWAYS" />
                            <ToggleButton fx:id="roleOperator" maxWidth="Infinity" styleClass="role-chip" text="Operator" toggleGroup="$roleGroup" userData="OPERATOR" HBox.hgrow="ALWAYS" />
                        </HBox>
                    </VBox>

                    <!-- Username / Email -->
                    <VBox spacing="6.0">
                        <Label styleClass="field-label" text="USERNAME / EMAIL" />
                        <TextField fx:id="loginEmailField" promptText="name@crisasterhub.com" styleClass="underline-input" />
                    </VBox>

                    <!-- Password -->
                    <VBox spacing="6.0">
                        <Label styleClass="field-label" text="PASSWORD" />
                        <StackPane alignment="CENTER_RIGHT">
                            <PasswordField fx:id="loginPasswordField" promptText="••••••••••••" styleClass="underline-input" />
                            <TextField fx:id="loginPasswordVisibleField" managed="false" promptText="••••••••••••" styleClass="underline-input" visible="false" />
                            <Button fx:id="togglePasswordBtn" onAction="#handleTogglePasswordVisibility" styleClass="icon-btn">
                                <graphic>
                                    <SVGPath fx:id="eyeIcon" content="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" scaleX="0.8" scaleY="0.8" styleClass="eye-icon" />
                                </graphic>
                                <StackPane.margin>
                                    <Insets right="6.0" />
                                </StackPane.margin>
                            </Button>
                        </StackPane>
                    </VBox>

                    <!-- Error Label -->
                    <Label fx:id="loginErrorLabel" managed="false" styleClass="error-label" visible="false" />

                    <!-- Log In Button -->
                    <Button fx:id="loginSubmitBtn" defaultButton="true" maxWidth="Infinity" onAction="#handleLoginSubmit" styleClass="primary-gradient-cta" text="Log In">
                        <graphic>
                            <SVGPath content="M11 7L9.6 8.4l2.6 2.6H2v2h10.2l-2.6 2.6L11 17l5-5-5-5zm9 12h-8v2h8c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2h-8v2h8v14z" scaleX="0.8" scaleY="0.8" styleClass="cta-icon" />
                        </graphic>
                        <VBox.margin>
                            <Insets top="8.0" />
                        </VBox.margin>
                    </Button>
                </VBox>

                <!-- 2. REGISTER PANE -->
                <VBox fx:id="registerPane" managed="false" spacing="18.0" visible="false">
                    <Label styleClass="form-helper-text"     text="Please enter your details to create your CrisasterHub account" />

                    <!-- Full Name & Username -->
                    <HBox spacing="14.0">
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                            <Label styleClass="field-label" text="FULL NAME" />
                            <StackPane alignment="CENTER_RIGHT">
                                <TextField fx:id="regNameField" promptText="name surname" styleClass="underline-input" />
                                <SVGPath fx:id="nameCheckIcon" content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" scaleX="0.75" scaleY="0.75" styleClass="check-icon" visible="false">
                                    <StackPane.margin><Insets right="8.0" /></StackPane.margin>
                                </SVGPath>
                            </StackPane>
                        </VBox>

                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                            <Label styleClass="field-label" text="USERNAME" />
                            <StackPane alignment="CENTER_RIGHT">
                                <TextField fx:id="regUsernameField" promptText="username" styleClass="underline-input" />
                                <SVGPath fx:id="userCheckIcon" content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" scaleX="0.75" scaleY="0.75" styleClass="check-icon" visible="false">
                                    <StackPane.margin><Insets right="8.0" /></StackPane.margin>
                                </SVGPath>
                            </StackPane>
                        </VBox>
                    </HBox>

                    <!-- Email Address -->
                    <VBox spacing="6.0">
                        <Label styleClass="field-label" text="EMAIL ADDRESS" />
                        <StackPane alignment="CENTER_RIGHT">
                            <TextField fx:id="regEmailField" promptText="name@crisasterhub.com" styleClass="underline-input" />
                            <SVGPath fx:id="emailCheckIcon" content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" scaleX="0.75" scaleY="0.75" styleClass="check-icon" visible="false">
                                <StackPane.margin><Insets right="8.0" /></StackPane.margin>
                            </SVGPath>
                        </StackPane>
                    </VBox>

                    <!-- Password & Confirm Password -->
                    <HBox spacing="14.0">
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                            <Label styleClass="field-label" text="PASSWORD" />
                            <StackPane alignment="CENTER_RIGHT">
                                <PasswordField fx:id="regPasswordField" promptText="Min. 6 chars" styleClass="underline-input" />
                                <SVGPath fx:id="pwdCheckIcon" content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" scaleX="0.75" scaleY="0.75" styleClass="check-icon" visible="false">
                                    <StackPane.margin><Insets right="8.0" /></StackPane.margin>
                                </SVGPath>
                            </StackPane>
                        </VBox>

                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                            <Label styleClass="field-label" text="CONFIRM PASSWORD" />
                            <StackPane alignment="CENTER_RIGHT">
                                <PasswordField fx:id="regConfirmPasswordField" promptText="Repeat password" styleClass="underline-input" />
                                <SVGPath fx:id="confirmCheckIcon" content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" scaleX="0.75" scaleY="0.75" styleClass="check-icon" visible="false">
                                    <StackPane.margin><Insets right="8.0" /></StackPane.margin>
                                </SVGPath>
                            </StackPane>
                        </VBox>
                    </HBox>

                    <Label fx:id="registerErrorLabel" managed="false" styleClass="error-label" visible="false" />

                    <!-- Complete Registration Button -->
                    <Button fx:id="registerSubmitBtn" maxWidth="Infinity" onAction="#handleRegisterSubmit" styleClass="primary-gradient-cta" text="Complete Registration">
                        <graphic>
                            <SVGPath content="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z" scaleX="0.8" scaleY="0.8" styleClass="cta-icon" />
                        </graphic>
                        <VBox.margin>
                            <Insets top="8.0" />
                        </VBox.margin>
                    </Button>
                </VBox>

            </StackPane>
        </VBox>

        <!-- Footer -->
        <HBox alignment="CENTER" spacing="12.0">
            <Label styleClass="footer-dot" text="•" />
            <Label styleClass="footer-text" text="CREATED BY HARUN BEHLÜL PINARLI &amp; OZAN YANTUR" />
            <Label styleClass="footer-dot" text="•" />
        </HBox>
    </VBox>
</StackPane>
